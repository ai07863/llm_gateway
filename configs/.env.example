# 网关鉴权 token（务必改成你自己的）
GATEWAY_TOKEN=change-me
LISTEN_ADDR=:8080
DB_PATH=gateway.db
BUDGET_MONTHLY_LIMIT=20
BUDGET_SOFT_RATIO=0.8

# 用量记录保留天数：0 = 永久保留；>0 时启动及每天清理更早的记录
RETENTION_DAYS=0

# 价格表远程刷新（可选）：指向一份 JSON 价格表；留空则只用内置默认价
PRICING_URL=
PRICING_REFRESH_INTERVAL=6h

# 阿里云 DashScope（通义千问）—— 走 OpenAI 兼容端点。
# 填入 DASHSCOPE_API_KEY 即启用；qwen-plus 为默认模型，
# text-embedding-v3 供语义缓存与 /v1/embeddings 使用。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# 额外可路由模型（逗号分隔，主模型自动包含）；会出现在 /v1/models 中
DASHSCOPE_MODELS=
DASHSCOPE_EMBED_MODEL=text-embedding-v3

# 其它 provider（可选，留空则不启用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODELS=
DEEPSEEK_EMBED_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODELS=
OPENAI_EMBED_MODEL=